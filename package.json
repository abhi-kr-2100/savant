{
  "name": "savant",
  "version": "1.0.0",
  "description": "Learn anything. Then retain it for life.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.vite.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.vite.json",
    "dev": "vite",
    "dev:app": "concurrently -k \"pnpm dev\" \"tsc -p tsconfig.node.json -w\" \"wait-on tcp:5173 dist/main.js && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "prestart": "pnpm build",
    "start": "electron ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "content-security-policy-parser": "^0.6.0",
    "electron": "41.9.1",
    "parse5": "^8.0.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
